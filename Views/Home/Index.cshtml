@{
    ViewData["Title"] = "Inicio";
    ViewData["HideNavigation"] = true;
}

<section class="landing" aria-labelledby="landing-title">
    <div class="landing-content">
        <p class="landing-eyebrow">Santo Tomás</p>
        <h1 id="landing-title">Organizador de dietas</h1>
        <p class="landing-description">Un espacio para que médicos y pacientes gestionen su información desde una sola cuenta.</p>
        <div class="landing-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Registrarse</a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </div>
    </div>
</section>
