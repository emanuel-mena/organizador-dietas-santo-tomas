@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="ui-card mx-auto max-w-xl text-center" aria-labelledby="error-title"><span class="ui-brand-mark mx-auto mb-6 bg-danger-soft text-danger"><partial name="UI/_Icon" model='@("alert")' /></span><p class="ui-eyebrow">Algo salió mal</p><h1 id="error-title">No pudimos completar la solicitud.</h1><p class="ui-description mb-6">Inténtalo de nuevo en unos momentos.</p>
@if (Model.ShowRequestId) { <p class="mb-6 break-all text-sm text-muted">Identificador de solicitud: <code>@Model.RequestId</code></p> }
<a class="ui-btn ui-btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a></section>
