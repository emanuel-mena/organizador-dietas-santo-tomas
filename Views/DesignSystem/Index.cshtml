@{
    ViewData["Title"] = "Sistema de diseño";
    var diet = new DietUiModel("Equilibrio diario", "Una propuesta variada para organizar las comidas de la semana.", 2000, 250, 100, 67);
    var assignment = new AssignmentUiModel("María Solís", diet.Name, new DateOnly(2026, 11, 1), new DateOnly(2026, 11, 30));
}
<div class="ui-page-header"><div><p class="ui-eyebrow">Santo Tomás / Sistema de diseño</p><h1>Diseñado para cuidar.</h1><p class="ui-description">Componentes que dan forma a una experiencia clara, cercana y accesible.</p></div><partial name="UI/_Badge" model='@(new BadgeUiModel("Solo desarrollo", "success"))' /></div>
<partial name="UI/_Alert" model='@(new AlertUiModel("Galería de demostración", "Los nombres, dietas y valores de esta página son ficticios. Las interacciones no guardan datos.", "warning"))' />
<nav class="ui-actions mt-6" aria-label="Secciones de la galería"><a class="ui-btn ui-btn-secondary" href="#identity">Identidad</a><a class="ui-btn ui-btn-secondary" href="#controls">Controles</a><a class="ui-btn ui-btn-secondary" href="#people">Personas</a><a class="ui-btn ui-btn-secondary" href="#nutrition">Nutrición</a><a class="ui-btn ui-btn-secondary" href="#assignment">Asignaciones</a></nav>

<section class="ui-section" id="identity" aria-labelledby="identity-title">
    <div><p class="ui-eyebrow">01 / Identidad</p><h2 id="identity-title">Una paleta que se siente natural.</h2></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div class="rounded-3xl bg-evergreen p-6 text-white"><p class="font-semibold">Evergreen</p><p class="text-sm">#132a13</p><p class="mt-10 text-sm">Texto principal</p></div>
        <div class="rounded-3xl bg-hunter-green p-6 text-white"><p class="font-semibold">Hunter green</p><p class="text-sm">#31572c</p><p class="mt-10 text-sm">Acción principal</p></div>
        <div class="rounded-3xl bg-fern p-6 text-white"><p class="font-semibold">Fern</p><p class="text-sm">#4f772d</p><p class="mt-10 text-sm">Acentos y foco</p></div>
        <div class="rounded-3xl bg-palm-leaf p-6 text-evergreen"><p class="font-semibold">Palm leaf</p><p class="text-sm">#90a955</p><p class="mt-10 text-sm">Detalles naturales</p></div>
        <div class="rounded-3xl bg-lime-cream p-6 text-evergreen"><p class="font-semibold">Lime cream</p><p class="text-sm">#ecf39e</p><p class="mt-10 text-sm">Destacados suaves</p></div>
    </div>
</section>

<section class="ui-section" id="controls" aria-labelledby="controls-title">
    <div><p class="ui-eyebrow">02 / Acciones y formularios</p><h2 id="controls-title">Cada interacción, clara.</h2></div>
    <div class="ui-card space-y-6">
        <div><h3 class="mb-4">Botones</h3><div class="ui-actions"><button type="button" class="ui-btn ui-btn-primary">Acción principal</button><button type="button" class="ui-btn ui-btn-secondary">Secundaria</button><button type="button" class="ui-btn ui-btn-ghost">Discreta</button><button type="button" class="ui-btn ui-btn-danger">Eliminar</button><button type="button" class="ui-btn ui-btn-accent">Destacada<partial name="UI/_Icon" model='@("arrow")' /></button></div></div>
        <div class="ui-actions"><button type="button" class="ui-btn ui-btn-primary" disabled>No disponible</button><button type="button" class="ui-btn ui-btn-primary" aria-busy="true" disabled>Guardando…</button><span class="ui-hint">Usa Tab para recorrer los controles y ver su foco.</span></div>
        <p class="ui-hint">Hover, foco y pulsación usan las mismas variantes en toda la aplicación. El estado de carga incluye texto y bloquea envíos repetidos.</p>
    </div>
    <div class="ui-card"><h3 class="mb-6">Campos de ejemplo</h3><div class="grid gap-6 sm:grid-cols-2">
        <div class="ui-field"><label for="demo-name" class="ui-label">Nombre completo</label><input id="demo-name" class="ui-input" type="text" placeholder="Ej. María Solís" autocomplete="off" /></div>
        <div class="ui-field"><label for="demo-password" class="ui-label">Contraseña</label><input id="demo-password" class="ui-input" type="password" autocomplete="new-password" aria-describedby="demo-password-hint" /><p id="demo-password-hint" class="ui-hint">Ejemplo visual; no se envía.</p></div>
        <div class="ui-field"><label for="demo-number" class="ui-label">Porciones</label><input id="demo-number" class="ui-input" type="number" min="1" value="2" /></div>
        <div class="ui-field"><label for="demo-date" class="ui-label">Fecha de consulta</label><input id="demo-date" class="ui-input" type="date" value="2026-11-01" /></div>
        <div class="ui-field"><label for="demo-select" class="ui-label">Tiempo de comida</label><select id="demo-select" class="ui-input"><option>Desayuno</option><option>Almuerzo</option><option>Cena</option></select></div>
        <div class="ui-field"><label for="demo-disabled" class="ui-label">Campo deshabilitado</label><input id="demo-disabled" class="ui-input" value="No editable" disabled /></div>
        <div class="ui-field"><label for="demo-error" class="ui-label">Correo con error de ejemplo</label><input id="demo-error" class="ui-input" type="email" value="correo-incompleto" aria-invalid="true" aria-describedby="demo-error-message" /><p id="demo-error-message" class="ui-error">Error: ingresa un correo válido.</p></div>
        <div class="ui-field"><label for="demo-notes" class="ui-label">Observaciones (opcional)</label><textarea id="demo-notes" class="ui-input" placeholder="Preferencias y observaciones…"></textarea></div>
        <fieldset class="space-y-3"><legend class="ui-label mb-3">Preferencias de ejemplo</legend><label class="ui-choice"><input type="checkbox" checked />Incluir meriendas</label><label class="ui-choice"><input type="checkbox" />Mostrar porciones</label></fieldset>
        <fieldset class="space-y-3"><legend class="ui-label mb-3">Frecuencia de ejemplo</legend><label class="ui-choice"><input type="radio" name="frequency" value="daily" checked />Diaria</label><label class="ui-choice"><input type="radio" name="frequency" value="weekly" />Semanal</label></fieldset>
    </div></div>
</section>

<section class="ui-section" id="people" aria-labelledby="people-title">
    <div><p class="ui-eyebrow">03 / Personas y búsqueda</p><h2 id="people-title">Un equipo con nombre propio.</h2></div>
    <div class="ui-card" data-search-list>
        <partial name="UI/_Search" model='@(new SearchUiModel("demo-search", "Buscar en los perfiles de demostración", "Nombre o correo electrónico"))' />
        <ul class="grid gap-4 sm:grid-cols-2" data-search-results>
            <li class="rounded-2xl border border-line p-5" data-search-item data-search-text="María Solís maria@ejemplo.com"><partial name="UI/_Profile" model='@(new ProfileUiModel("María Solís", "maria@ejemplo.com", "Paciente", "Datos de demostración"))' /></li>
            <li class="rounded-2xl border border-line p-5" data-search-item data-search-text="Andrés Mora andres@ejemplo.com"><partial name="UI/_Profile" model='@(new ProfileUiModel("Andrés Mora", "andres@ejemplo.com", "Médico", "Datos de demostración"))' /></li>
        </ul>
    </div>
</section>

<section class="ui-section" aria-labelledby="states-title">
    <div><p class="ui-eyebrow">04 / Estados y mensajes</p><h2 id="states-title">Información que acompaña.</h2></div>
    <div class="ui-actions"><partial name="UI/_Badge" model='@(new BadgeUiModel("Borrador"))' /><partial name="UI/_Badge" model='@(new BadgeUiModel("Activo", "success"))' /><partial name="UI/_Badge" model='@(new BadgeUiModel("Pendiente", "warning"))' /><partial name="UI/_Badge" model='@(new BadgeUiModel("Requiere revisión", "danger"))' /></div>
    <div class="grid gap-4 lg:grid-cols-3"><partial name="UI/_Alert" model='@(new AlertUiModel("Cambios guardados", "Ejemplo de confirmación."))' /><partial name="UI/_Alert" model='@(new AlertUiModel("Revisa las fechas", "Ejemplo de advertencia.", "warning"))' /><partial name="UI/_Alert" model='@(new AlertUiModel("No se pudo guardar", "Ejemplo de error. Inténtalo de nuevo.", "danger"))' /></div>
    <partial name="UI/_Empty" model='@(new EmptyUiModel("Todo listo para empezar", "Aquí aparecerán los elementos cuando estén disponibles."))' />
</section>

<section class="ui-section" id="nutrition" aria-labelledby="nutrition-title">
    <div><p class="ui-eyebrow">05 / Nutrición · Demostración</p><h2 id="nutrition-title">Un plan fácil de leer.</h2><p class="ui-description">Ejemplos visuales para los futuros módulos de dietas. Los valores no son recomendaciones nutricionales.</p></div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <partial name="UI/_Diet" model="diet" />
        <partial name="UI/_Meal" model='@(new MealUiModel("Desayuno", "07:30", "Avena, fruta fresca y yogur natural", "1 tazón · 250 g", 420))' />
        <div class="space-y-6"><partial name="UI/_Stat" model='@(new StatUiModel("Energía de ejemplo", "2000 kcal", "Referencia visual diaria", "chart"))' /><div class="ui-card"><label for="demo-progress" class="ui-label mb-3">Comidas registradas · 3 de 5</label><progress id="demo-progress" class="ui-progress" value="3" max="5">3 de 5</progress></div></div>
    </div>
</section>

<section class="ui-section" id="assignment" aria-labelledby="assignment-title" data-assignment-demo>
    <div><p class="ui-eyebrow">06 / Asignaciones · Demostración</p><h2 id="assignment-title">Del plan a la persona.</h2><p class="ui-description">Modifica los campos y actualiza la tarjeta. La vista previa vive solo en esta página.</p></div>
    <div class="grid items-start gap-6 md:grid-cols-2">
        <form class="ui-card ui-form" aria-label="Ejemplo de asignación">
            <div class="ui-field"><label for="assignment-patient" class="ui-label">Paciente</label><select id="assignment-patient" name="patient" class="ui-input" required><option>María Solís</option><option>Andrés Mora</option></select></div>
            <div class="ui-field"><label for="assignment-diet" class="ui-label">Dieta</label><select id="assignment-diet" name="diet" class="ui-input" required><option>Equilibrio diario</option><option>Variedad semanal</option></select></div>
            <div class="grid gap-4 sm:grid-cols-2"><div class="ui-field"><label for="assignment-start" class="ui-label">Inicio</label><input class="ui-input" id="assignment-start" name="start" type="date" value="2026-11-01" required /></div><div class="ui-field"><label for="assignment-end" class="ui-label">Fin</label><input class="ui-input" id="assignment-end" name="end" type="date" value="2026-11-30" min="2026-11-01" required /></div></div>
            <button type="submit" class="ui-btn ui-btn-primary">Actualizar vista previa<partial name="UI/_Icon" model='@("arrow")' /></button>
        </form>
        <div><partial name="UI/_Assignment" model="assignment" /><p class="ui-hint mt-4" role="status" data-preview-status>Ejemplo sin persistencia.</p></div>
    </div>
</section>
