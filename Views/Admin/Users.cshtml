@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Usuarios</h1><a class="btn btn-primary" asp-action="CreateUser">Crear usuario</a>
</div>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@(user.Role == AppRoles.Doctor ? "Médico" : user.Role)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Count == 0)
{
    <p>No hay usuarios.</p>
}
