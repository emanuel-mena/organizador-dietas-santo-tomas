@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "Mis pacientes";
}
<h1>Mis pacientes</h1>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<div class="d-flex gap-2 mb-3"><a class="btn btn-primary" asp-action="CreatePatient">Crear paciente</a><a
    class="btn btn-outline-primary" asp-action="AssociatePatient">Asociar paciente existente</a></div>
    @if (Model.Count == 0)
    {
        <p>Aún no tiene pacientes asociados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Origen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>@patient.FullName</td>
                            <td>@patient.Email</td>
                            <td>@(patient.CreatedByCurrentDoctor ? "Creado por usted" : "Asociado")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
