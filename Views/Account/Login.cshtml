@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="ui-auth">
    <aside class="ui-card ui-card-accent flex flex-col justify-between gap-8"><span class="ui-brand-mark bg-white"><partial name="UI/_Icon" model='@("leaf")' /></span><div><p class="ui-eyebrow">Bienvenido de nuevo</p><h2>Retoma el camino hacia tu bienestar.</h2><p class="ui-description">Tu información y tu equipo, en un mismo lugar.</p></div></aside>
    <section class="ui-card" aria-labelledby="login-title">
        <p class="ui-eyebrow">Tu cuenta Santo Tomás</p><h1 id="login-title">Iniciar sesión</h1><p class="ui-description mb-7">Ingresa tus datos para continuar.</p>
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="ui-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="ui-validation" role="alert" tabindex="-1"></div>
            <div class="ui-field"><label asp-for="Email" class="ui-label"></label><input asp-for="Email" class="ui-input" autocomplete="username" aria-describedby="Email-validation" /><span asp-validation-for="Email" id="Email-validation" class="ui-error"></span></div>
            <div class="ui-field"><label asp-for="Password" class="ui-label"></label><input asp-for="Password" class="ui-input" autocomplete="current-password" aria-describedby="Password-validation" /><span asp-validation-for="Password" id="Password-validation" class="ui-error"></span></div>
            <button class="ui-btn ui-btn-primary w-full" type="submit">Entrar<partial name="UI/_Icon" model='@("arrow")' /></button>
        </form>
        <p class="mt-6 text-sm text-muted">¿No tienes cuenta? <a class="ui-link" asp-action="Register">Regístrate</a>.</p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
